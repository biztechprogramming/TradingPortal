#!/usr/bin/env bash
# Bring the dashboard up. The IBKR gateway is left to the dashboard's Log in button.
#
# The app itself runs natively rather than in Docker, because the Schwab
# refresh tokens live in ./var/state on the host. The container keeps its
# state in a separate volume and has never been authorised.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

GREEN=$'\033[32m'; RED=$'\033[31m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
STATE="$HERE/var/state"
PIDFILE="$STATE/dashboard.pid"
LOGFILE="$STATE/dashboard.log"
mkdir -p "$STATE"

step() { printf '\n%s==>%s %s\n' "$GREEN" "$OFF" "$1"; }
warn() { printf '%s !  %s%s\n' "$YELLOW" "$1" "$OFF"; }
fail() { printf '%s XX %s%s\n' "$RED" "$1" "$OFF"; }

# --- 1. IBKR gateway ---------------------------------------------------------
# Deliberately NOT started here. A running gateway logs in by itself and holds
# the one IBKR session, which locks you out of IBKR in any browser. Log in and
# out from the dashboard's Logins panel instead.
step "IBKR gateway"

if [ -n "$(docker ps -q -f name=qqq-ibeam -f name=qqq-ibgateway 2>/dev/null)" ]; then
    echo "    running (logged in) — use Log out on the dashboard to free the session"
else
    echo "    not started — click Log in on the dashboard when you want IBKR"
fi

# --- 2. dashboard ------------------------------------------------------------
step "Dashboard"

# Bind the Tailscale interface so every machine on the tailnet reaches the
# dashboard. .env keeps API_HOST=127.0.0.1 as the safe default and the app's
# load_dotenv() does not override a real env var, so this widens the bind only
# while Tailscale is actually up -- and onto the tailnet alone, never the LAN.
TS_IP="$(tailscale ip -4 2>/dev/null | head -1 || true)"
if [ -n "$TS_IP" ]; then
    export API_HOST="$TS_IP"
    echo "    binding $TS_IP (Tailscale)"
else
    warn "Tailscale is down - binding 127.0.0.1, reachable from this machine only"
fi

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "    already running (pid $(cat "$PIDFILE"))"
    if [ -n "$TS_IP" ]; then
        warn "a running dashboard keeps its old bind: ./stop && ./start to move it to $TS_IP"
    fi
else
    rm -f "$PIDFILE"
    nohup ./qqq serve >"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 3
    if ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        rm -f "$PIDFILE"
        fail "dashboard failed to start. Last lines of $LOGFILE:"
        tail -15 "$LOGFILE"
        exit 1
    fi
    echo "    started (pid $(cat "$PIDFILE"))"
fi

TOKEN="$(./ensure-token)"
PORT="$(grep -E '^API_PORT=.+' .env | head -1 | cut -d= -f2- || true)"
PORT="${PORT:-8787}"

TSLINE=""
if [ -n "$TS_IP" ]; then
    TSLINE="
  Tailnet: ${YELLOW}http://${TS_IP}:${PORT}/?token=${TOKEN}${OFF}   ${DIM}(any machine on the tailnet)${OFF}"
fi

cat <<BANNER

${GREEN}Everything is up.${OFF} Log in to Schwab and IBKR from the dashboard's Logins panel.

  Open:   ${YELLOW}http://localhost:${PORT}/?token=${TOKEN}${OFF}   ${DIM}(forward port ${PORT} in VS Code's PORTS panel)${OFF}${TSLINE}
  Token:  ${YELLOW}${TOKEN}${OFF}

${DIM}  Schwab login needs port 8182 forwarded too.  Logs: tail -f ${LOGFILE}   Stop: ./stop${OFF}

BANNER
