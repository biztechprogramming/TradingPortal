# =============================================================================
# QQQ / PSQ Switch — configuration template
#
# Copy to .env and fill in. NEVER commit .env. No value here is a credential.
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# TRADING MODE — the most important setting in this file
# -----------------------------------------------------------------------------
# dry_run : DEFAULT. No order ever reaches a broker. Reads are real (if
#           credentials are present) so you rehearse against your true balances.
# paper   : Orders go to broker PAPER environments only. IBKR paper works fully.
#           Schwab has no paper API, so Schwab stays simulated in this mode.
# live    : REAL ORDERS WITH REAL MONEY.
TRADING_MODE=dry_run

# Second switch. TRADING_MODE=live is refused unless this is also true, so live
# trading can never be enabled by changing one variable.
LIVE_TRADING_ENABLED=false

# Require a deliberate confirmation immediately before a LIVE long/short.
# GO FLAT never requires confirmation — de-risking must stay one tap away.
REQUIRE_CONFIRMATION=true
CONFIRMATION_TTL_SECONDS=60
LIVE_CONFIRMATION_PHRASE=EXECUTE

# Which brokers to run. Comma separated: schwab, ibkr, simulated
BROKERS_ENABLED=schwab,ibkr

# -----------------------------------------------------------------------------
# INSTRUMENTS
# -----------------------------------------------------------------------------
LONG_SYMBOL=QQQ
SHORT_SYMBOL=PSQ

# -----------------------------------------------------------------------------
# CHARLES SCHWAB  (see docs/SCHWAB_SETUP.md)
# -----------------------------------------------------------------------------
# ONE developer app serves every login. The key/secret belong to the app.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/
SCHWAB_BASE_URL=https://api.schwabapi.com

# One label per Schwab user ID. Each is authorised separately
# (`cli schwab-login --login <label>`) and gets its OWN token file: sharing
# one file between logins makes each refresh invalidate the other.
# Example for two logins:  SCHWAB_LOGINS=personal,joint
SCHWAB_LOGINS=default

# Token files are derived from STATE_DIR automatically, one per login:
#   <STATE_DIR>/schwab_token_<label>.json
# Leave these commented out unless you want them somewhere else. Setting
# SCHWAB_TOKEN_PATH explicitly overrides the derivation, so STATE_DIR would
# no longer move the token files with the rest of the state.
# SCHWAB_TOKEN_PATH=var/state/schwab_token.json
# SCHWAB_TOKEN_PATH_PERSONAL=/secure/schwab_token_personal.json
# SCHWAB_TOKEN_PATH_JOINT=/secure/schwab_token_joint.json

# Legacy single-account pin. Prefer TRADING_ACCOUNTS below.
SCHWAB_ACCOUNT_NUMBER=

# -----------------------------------------------------------------------------
# ACCOUNT PERMISSIONS
#
# Schwab has no read-only API scope: an account the app can see is an account
# it can trade. This allowlist restores that separation in software. Accounts
# outside it are shown on the dashboard but every order path raises.
#
# Full account numbers or last-4 digits, comma separated.
# EMPTY MEANS EVERY AUTHORISED ACCOUNT CAN TRADE.
# -----------------------------------------------------------------------------
TRADING_ACCOUNTS=

# Show authorised-but-not-tradable accounts read-only on the dashboard.
SHOW_READONLY_ACCOUNTS=true

# -----------------------------------------------------------------------------
# INTERACTIVE BROKERS  (see docs/IBKR_SETUP.md)
# -----------------------------------------------------------------------------
# Local Client Portal Gateway. Paper and live are chosen by which credentials
# you log the gateway in with — paper account ids start with D (e.g. DU1234567).
IBKR_BASE_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=
# Or, for several IBKR accounts under one gateway login:
# IBKR_ACCOUNT_IDS=DU1234567,DU7654321
# Leave both empty to use every account the gateway exposes.
# The gateway uses a self-signed certificate on localhost.
IBKR_VERIFY_SSL=false
# Optional: pin contract ids so symbol lookup can never resolve the wrong one.
# IBKR_CONID_QQQ=320227571
# IBKR_CONID_PSQ=43645828
# Refuse to trade on delayed data (recommended false = refuse).
IBKR_ALLOW_DELAYED_QUOTES=false
# Auto-answer EVERY IBKR order-confirmation prompt, including unrecognised
# ones. Leave false: unknown prompts stop the order instead.
IBKR_AUTO_CONFIRM_ALL_QUESTIONS=false

# -----------------------------------------------------------------------------
# POSITION SIZING
# -----------------------------------------------------------------------------
# Held back so rounding, fees or a tick of price movement cannot trigger an
# insufficient-funds rejection.
CASH_BUFFER_DOLLARS=25

# Cash only by default. When false, extra margin buying power is ignored even
# if the broker advertises it. This system never borrows and never shorts.
ALLOW_MARGIN=false

# Hard caps. 0 = no cap.
MAX_ORDER_NOTIONAL_DOLLARS=0
MAX_SHARES_PER_ORDER=0
MIN_ORDER_SHARES=1

# Optional fee modelling (Schwab and IBKR Lite are $0 for US ETFs).
ESTIMATED_FEE_FIXED=0
ESTIMATED_FEE_PER_SHARE=0

# -----------------------------------------------------------------------------
# LIMIT-ORDER PRICING  (see docs/LIMIT_ALGORITHM.md)
# Slippage may be given in basis points OR percent. Percent wins if both are
# set. 10 bps = 0.10%.
# -----------------------------------------------------------------------------
BUY_SLIPPAGE_BPS=10
SELL_SLIPPAGE_BPS=10
# BUY_SLIPPAGE_PCT=0.10
# SELL_SLIPPAGE_PCT=0.10

# HARD GUARD. The order is never priced beyond this distance from the price
# captured when the leg began. If the market runs past it, the command aborts
# and alerts rather than chasing.
MAX_SLIPPAGE_BPS=50

# Added to the offset on each cancel/replace, up to MAX_SLIPPAGE_BPS.
REPRICE_STEP_BPS=5

# Refuse to trade when the bid/ask spread is wider than this.
MAX_SPREAD_BPS=75

# Refuse to trade on a quote older than this many seconds.
MAX_QUOTE_AGE_SECONDS=10

TICK_SIZE=0.01

# -----------------------------------------------------------------------------
# ORDER MONITORING
# -----------------------------------------------------------------------------
ORDER_FILL_TIMEOUT_SECONDS=90
ORDER_POLL_INTERVAL_SECONDS=1
REPRICE_INTERVAL_SECONDS=5
MAX_REPRICE_ATTEMPTS=5
CANCEL_CONFIRM_TIMEOUT_SECONDS=15
# How long to wait for sale proceeds to show as available before sizing the buy.
SETTLEMENT_WAIT_SECONDS=5

# -----------------------------------------------------------------------------
# SAFETY
# -----------------------------------------------------------------------------
# Re-issuing the same command inside this window is refused (double-tap guard).
DUPLICATE_COMMAND_WINDOW_SECONDS=30
# When brokers end a command in different states, block further trading until
# acknowledged. GO FLAT stays available.
REQUIRE_MISMATCH_ACK=true
# Runaway-automation guard. 0 = unlimited.
MAX_DAILY_COMMANDS=50
# Refuse to trade outside 09:30-16:00 ET on a weekday.
MARKET_HOURS_GUARD=true
ALLOW_OUTSIDE_RTH=false
HTTP_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# LOCAL INTERFACE
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1

# The port the app listens on. Under Docker this moves BOTH sides of the port
# mapping, so this one variable is all you normally need to change.
API_PORT=8787

# Docker only, and rarely needed: publish on a different HOST port than the
# one the container listens on. Leave commented unless you specifically want
# host and container to differ.
# HOST_API_PORT=8795
# Required before live trading. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

LOG_DIR=var/log
STATE_DIR=var/state
LOG_LEVEL=INFO
